include bestiary/traits
include bestiary/actions
include bestiary/capacites
include bestiary/legacy

mixin bestiary-view(struct)
  section.sheet-bestiaire--view
    +bestiary-traits-view(struct)
    +bestiary-action-view(struct)
    +bestiary-capacites-view(struct)

mixin bestiary-edit(struct)
  section.sheet-bestiaire--edit
    +bestiary-traits-edit(struct)
    +bestiary-action-edit(struct)
    +bestiary-capacites-edit(struct)
    +bestiary-legacy-edit()