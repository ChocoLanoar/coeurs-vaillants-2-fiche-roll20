mixin traits-view(traits_struct)
  div(class=['column-left'])
    each field in traits_struct.view
      +display-value(field)

mixin niveau-view(niveau_struct)
  div(class=['column-right'])
    - const niveau_view = fieldDictionary(niveau_struct.view, '')
    .niveau
      +display-value(niveau_view.niveau)
      +display-value(niveau_view.xp)
      strong /
      +display-value(niveau_view.xpTotal)
    .tips-list
      +display-value(niveau_view.niveau_tips1)
      +display-value(niveau_view.niveau_tips2)
      +display-value(niveau_view.niveau_tips3)
      +display-value(niveau_view.niveau_tips4)

mixin header-view(character_struct)
  .header--view
    +traits-view(character_struct.traits)
    +niveau-view(character_struct.niveau)

mixin traits-edit(traits_struct)
  .column-left
    - const trait_edit = fieldDictionary(traits_struct.fields, '')
    .row-top
      +display-input(trait_edit.character_name)
      +display-input(trait_edit.langues)
    .row-top
      +display-input(trait_edit.charDesc)

mixin niveau-edit(niveau_struct)
  .row-top
    each field in niveau_struct.fields
      +display-input(field)

mixin header-edit(character_struct)
  .header--edit
    .sheet-ligne(style="text-align: center;")
      img(
        title="Version 2.0 - 02/07/2022"
        src="https://raw.githubusercontent.com/Roll20/roll20-character-sheets/master/CoeursVaillants-2/images/Logo.png"
        width="30%"
      )
    +traits-edit(character_struct.traits)
    +niveau-edit(character_struct.niveau)