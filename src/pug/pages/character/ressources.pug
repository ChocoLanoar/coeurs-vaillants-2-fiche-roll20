mixin origine-view(struct_origine)
  .column-left.border-bottom
    each field in struct_origine.view
      +display-value(field)

mixin metiers-view(struct_metiers)
  - const metier_view = fieldDictionary(struct_metiers.view, '')
  +display-repeater(struct_metiers.repeater_name)
    .row-top
      .column-left
        +display-value(metier_view.capaName)
        +display-value(metier_view.capaAtour)
        +display-value(metier_view.capaUsuel)
        +display-value(metier_view.capaProuesse)
      +display-input(metier_view.utilUsuel)

mixin ressources-view(struct)
  .ressources--view
    +origine-view(struct.origine)
    +metiers-view(struct.metiers)

mixin origine-edit(origine_struct)
  .column-left.border-bottom
    each field in origine_struct.fields
      +display-input(field)

mixin metier-edit(metier_struct)
  +display-repeater(metier_struct.repeater_name)
    .column-left
      each field in metier_struct.fields
        +display-input(field)

mixin ressources-edit(struct)
  .ressources--edit
    +origine-edit(struct.origine)
    +metier-edit(struct.metiers)
