mixin caracs-view(caracs_struct)
  .column-left
    each field in caracs_struct.view
      case field.type
        when 'hidden'
          +hidden_attr(field.name)
        default
          +display-value(field)

mixin counters-view(struct)
  .column-right
    .row-top
      .column-middle.life--view
        - const life_view = fieldDictionary(struct.life.view, '')
        h4 Points de Vie
        .life-counter
          +display-value(life_view.pv)
          strong /
          +display-value(life_view.pv_max)
        .life-temp-aggr
          +display-value(life_view.pvTemp)
          +display-value(life_view.pvAggr)
        .life-rolls
          +display-value(life_view.roll_testRepit)
          +display-value(life_view.roll_testSecSouffle)
      .column-middle
        - const aventure_view = fieldDictionary(struct.aventure.view, '')
        h4 Points d’Aventure
        .aventure-counter
          +display-value(aventure_view.aventure)
          strong /
          +display-value(aventure_view.aventure_max)
        +display-repeater('prouesses')
          .tips-list
            +display-value(aventure_view.aventure_prouesse)
    .row-bottom
      .column-middle
        - const defense_view = fieldDictionary(struct.defense.view, '')
        h4 Défense
        .defense-view
          +display-value(defense_view.ca)
          +display-value(defense_view.defBase)
      .column-middle
        - const mouvement_view = fieldDictionary(struct.mouvement.view, '')
        h4 Mouvement
        .mouvement-view
          +display-value(mouvement_view.mouvement)
          +display-value(mouvement_view.mouvementBase)

mixin talents-view(talents_struct)
  strong Talents et Compensations :
  +display-repeater(talents_struct.repeater_name)
    .talents-view
      each field in talents_struct.view
        +display-value(field)

mixin central-view(struct)
  .central--view
    .row-top.border-bottom
      +caracs-view(struct.caracs)
      +counters-view(struct)
    .row-bottom
      +talents-view(struct.talents)

mixin caracs-edit(carac_struct)
  - const caracs_edit = fieldDictionary(carac_struct.fields, '')
  +display-value(caracs_edit.rollCarac)
  .row-top.border-bottom
    p
      +display-input(caracs_edit.vig)
      +display-toggle-button(caracs_edit.CompVig.name, caracs_edit.CompVig.label)
    p
      +display-input(caracs_edit.dex)
      +display-toggle-button(caracs_edit.CompDex.name, caracs_edit.CompDex.label)
    p
      +display-input(caracs_edit.int)
      +display-toggle-button(caracs_edit.CompInt.name, caracs_edit.CompInt.label)
    p
      +display-input(caracs_edit.cha)
      +display-toggle-button(caracs_edit.CompCha.name, caracs_edit.CompCha.label)

mixin counter-edit(struct)
  .row-top.border-bottom
    - const life_edit = fieldDictionary(struct.life.fields, '')
    +display-input(life_edit.pv_max)
    +display-value(life_edit.jetdv)
    +display-input(life_edit.bonusPv)

  .row-top.border-bottom
    - const aventure_edit = fieldDictionary(struct.aventure.fields, '')
    +display-input(aventure_edit.aventure_max)
    each field in struct.aventure.repeating
      +display-repeater(field.repeater_name)
        +display-input(field)

  h4 Défense
  .row-top.border-bottom
    each field in struct.defense.fields
      +display-input(field)
    each field in struct.sauvegarde.fields
      +display-input(field)

  h4 Mouvement
  .row-top.border-bottom
    - const mouvement_edit = fieldDictionary(struct.mouvement.fields, '')
    +display-input(mouvement_edit.mouvementBase)
    +display-input(mouvement_edit.mouvement)
    +display-toggle-button(mouvement_edit.CompMou.name, mouvement_edit.CompMou.label)

mixin talents-edit(talents_struct)
  h4 Talents et Compensations
  +display-repeater(talents_struct.repeater_name)
    each field in talents_struct.fields
      +display-input(field)

mixin central-edit(character_struct)
  .central--edit
    +caracs-edit(character_struct.caracs)
    +counter-edit(character_struct)
    +talents-edit(character_struct.talents)
