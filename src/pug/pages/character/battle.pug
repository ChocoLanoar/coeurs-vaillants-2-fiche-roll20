mixin equipement-view(struct)
  .column-left
    h4 Équipement
    - const armor_view = fieldDictionary(struct.armure.view, '')
    .armure-view
      +display-value(armor_view.nameArmu)
      +display-value(armor_view.bonusArmu)
      +display-value(armor_view.descArmu)
    - const weapons_repeater = fieldDictionary(struct.weapons.repeating, '')
    - const weapons_view = fieldDictionary(struct.weapons.view, '')
    +display-repeater(weapons_repeater.invReapeaterName.repeater_name)
      .weapons-view
        +display-value(weapons_view.testcombat1)
        +display-value(weapons_view.invArme1)
        +display-value(weapons_view.bonusArme1)
        +display-value(weapons_view.dmgArme1)
        +display-value(weapons_view.armDesc1)
      .weapons-edit
        +display-input(weapons_view.invArme1)
        +display-input(weapons_view.bonusArme1)
        +display-input(weapons_view.dmgArme1)
        +display-input(weapons_view.armDesc1)

mixin battle-data-view(struct)
  .column-middle
    - const combat_view = fieldDictionary(struct.combat.view, '')
    h4
      div Combat
      +display-value(combat_view.bonusCombat)
    +display-value(combat_view.testinit)
    .trucs-view
      strong Trucs de combat
      .view-grid-4
        +display-value(combat_view.testtrucVig)
        +display-value(combat_view.testtrucDex)
        +display-value(combat_view.testtrucInt)
        +display-value(combat_view.testtrucCha)
    .vitesse-and-tips
      +display-value(combat_view.mvt)
      .vitesse-tips
        +display-value(combat_view.vit_tips1)
        +display-value(combat_view.vit_tips2)

mixin battle-view(struct)
  .battle--view
    +equipement-view(struct)
    +battle-data-view(struct)

mixin battle-data-edit(combat_struct)
  h4 Combat
  .row-top.border-bottom
    each field in combat_struct.fields
      +display-input(field)

mixin equipement-edit(struct)
  h4 Équipement
  .row-top
    each field in struct.armure.fields
      +display-input(field)
  - const weapons_repeater = fieldDictionary(struct.weapons.repeating, '')
  +display-repeater(weapons_repeater.invReapeaterName.repeater_name)
    .row-top
      +display-input(weapons_repeater.invArme1)
      +display-input(weapons_repeater.bonusArme1)
      +display-input(weapons_repeater.dmgArme1)
      +display-input(weapons_repeater.armDesc1)

mixin battle-edit(character_struct)
  .battle--edit
    +battle-data-edit(character_struct.combat)
    +equipement-edit(character_struct)
