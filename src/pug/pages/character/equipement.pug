mixin inventaire-view(struct)
  - const inventaire_view = fieldDictionary(struct.inventaire.fields, '')
  .inventaire--view
    .row-top
      .column-middle
        +display-input(inventaire_view.bonus)
      .column-middle
        +display-input(inventaire_view.equip)
    .row-bottom
      +display-input(inventaire_view.po)
