mixin bestiary-traits-view(struct)
  .bestiary-traits--view
    - const traits_view = fieldDictionary(struct.traits.view, '')
    .row-top
      +display-value(traits_view.character_name)
      p
        select(name="attr_jetCache", id="attr_jetCache", style="width: 110px; margin-left: 15px;")
          option(value="/w gm ") Jets cachés
          option(value=" ") Jets publics
    .row-top
      +display-value(traits_view.pnjNiv)
      p
        +display-input(traits_view.pnjpv)
        strong /
        +display-value(traits_view.pnjpv_max)
      +display-value(traits_view.pnjDef)
      +display-value(traits_view.pnjVts)
      +display-value(traits_view.jetsvgpnj)
      +display-value(traits_view.testinit)

mixin bestiary-traits-edit(struct)
  .bestiary-traits--edit
    - const traits_edit = fieldDictionary(struct.traits.fields, '')
    .row-top
      +display-input(traits_edit.character_name)
      p
        select(name="attr_jetCache", id="attr_jetCache", style="width: 110px; margin-left: 15px;")
          option(value="/w gm ") Jets cachés
          option(value=" ") Jets publics
    .row-top
      +display-input(traits_edit.pnjNiv)
      +display-input(traits_edit.pnjpv_max)
      +display-input(traits_edit.pnjPvBonus)
      +display-value(traits_edit.jetpvpnj)
    .row-top
      +display-input(traits_edit.pnjDef)
      +display-input(traits_edit.pnjVts)
      +display-input(traits_edit.pnjsvg)
      +display-input(traits_edit.initiative)