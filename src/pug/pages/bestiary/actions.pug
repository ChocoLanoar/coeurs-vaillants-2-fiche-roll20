mixin bestiary-action-view(struct)
  .bestiary-action--view
    h4 Actions
    .row-top
      +display-repeater(struct.attaques.repeater_name)
        .weapons-view
          each field in struct.attaques.view
            +display-value(field)
        .weapons-edit
          each field in struct.attaques.fields
            +display-input(field)
      +display-repeater(struct.otheractions.repeater_name)
        .weapons-view
          each field in struct.otheractions.view
            +display-value(field)
        .weapons-edit
          each field in struct.otheractions.fields
            +display-input(field)

mixin bestiary-action-edit(struct)
  .bestiary-action--edit
    h4 Attaques
    +display-repeater(struct.attaques.repeater_name)
      .row-top
        each field in struct.attaques.fields
          +display-input(field)
    h4 Autres actions
    +display-repeater(struct.otheractions.repeater_name)
      .row-top
        each field in struct.otheractions.fields
          +display-input(field)