-
  const fieldDictionary = (fields, removePrefix='') => {
    return fields.reduce((memo, val) => {
      const key = removePrefix ? val.name.replace(`${removePrefix}_`, '') : val.name;
      memo[key] = structuredClone(val);
      return memo
    }, {});
  }

mixin hidden_attr(field, value)
  input(name=field, value=value, type="hidden")

mixin display-value(blob)
  - const attr = `attr_${blob.name}`;
  - const default_class = blob.css ? blob.css : '';
  - const default_roll_class = blob.css_roll ? blob.css_roll : '';
  p(class=default_class)
    if blob.type
      case blob.type
        when 'roll'
          if blob.icon
            button(class=default_roll_class type=blob.type, name=blob.roll_name, title=blob.title, value=blob.value)
              img(class='default-icon', src=blob.icon alt='')
          else
            button(class=default_roll_class type=blob.type, name=blob.roll_name, title=blob.title, value=blob.value)= blob.label ? blob.label : ''
          if blob.display_attr
            span(name=attr, title=blob.title)
        default
          if blob.icon
            img(class='default-icon', src=blob.icon alt='')
          if blob.label
            strong= blob.label
          input(type=blob.type, name=attr, title=blob.title)
    else
      if blob.icon
        img(class='default-icon', src=blob.icon alt='')
      if blob.label
        strong= blob.label
      span(name=attr, title=blob.title)
    if blob.suffix
      strong= blob.suffix

mixin display-counter(attr, count)
  - for (var x = 0; x < count; x++)
      label
        input(type='radio', name=attr, value=x)
        span=x

mixin display-input(blob)
  - const attr = `attr_${blob.name}`;
  - const default_value = blob.value ? blob.value : '';
  - const default_class = blob.css ? blob.css : '';
  p(class=default_class)
    if blob.label
      strong= blob.label
    case blob.type
      when 'textarea'
        textarea(name=attr)=default_value
      when 'checkbox'
        input(type=blob.type, name=attr)
      when 'number'
      when 'text'
        input(type=blob.type, name=attr, value=default_value)
      when 'radio'
        +display-counter(attr, default_value)
      default
        input(type='text', name=attr, value=default_value)

mixin display-repeater(fieldset)
  fieldset(class=`repeating_${fieldset}`)
    block