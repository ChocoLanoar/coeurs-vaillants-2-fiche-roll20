include structure/structure
include components/mixins
include pages/character
include pages/bestiary.pug

+hidden_attr("attr_sheet_version", "")
+hidden_attr("attr_pvmax", "")
+hidden_attr("attr_aventureMax", "")
+hidden_attr("attr_type_fiche", "personnage")
+hidden_attr("attr_edit_mode", "on")

.coeurs-vaillants
  header
    .column-left
      label Mode édition
        input.edit_mode(id="edit_mode", name="attr_edit_mode", title="Activer/désactiver le mode édition", type="checkbox", checked)
      select.sheet-block_switch(name="attr_type_fiche")
        option(selected="selected", value="personnage") Personnage
        option(value="bestiaire") Bestiaire
    .column-middle
      img(
        title="Version 2.0 - 02/07/2022"
        src="https://raw.githubusercontent.com/Roll20/roll20-character-sheets/master/CoeursVaillants-2/images/Logo.png"
        width="50%"
      )

  main.sheet-personnage
    +character-view(structure.character)
    +character-edit(structure.character)

  main.sheet-bestiaire
    +bestiary-view(structure.bestiary)
    +bestiary-edit(structure.bestiary)

script(type='text/worker')
  include ../js/migration.js

include templates/rolltemplate